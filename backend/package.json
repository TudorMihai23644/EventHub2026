{
  "name": "eventhub-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:int": "jest --config jest.int.config.js --runInBand",
    "test:db:up": "docker run -d --rm --name eventhub-test-db -e POSTGRES_PASSWORD=test -e POSTGRES_DB=eventhub_test -p 127.0.0.1:55432:5432 postgres:16-alpine",
    "test:db:down": "docker stop eventhub-test-db",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/cli-data-source.ts",
    "migration:check": "typeorm-ts-node-commonjs migration:generate -d src/database/cli-data-source.ts --check src/database/migrations/Check",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/cli-data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/cli-data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/cli-data-source.ts",
    "migration:run:prod": "typeorm migration:run -d dist/database/cli-data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "helmet": "^8.3.0",
    "ics": "^3.12.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.37.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "testTimeout": 15000
  }
}
