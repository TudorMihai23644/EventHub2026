# Doar pentru rulare locală, fără Docker. Copiază în backend/.env (ignorat de Git).
# Sub Docker, aceste valori vin din fișierele din ../secrets (vezi README).
PORT=5200
DB_HOST=localhost
DB_PORT=5432
DB_USER=eventhub
DB_NAME=eventhub
# gol = originea din APP_URL (și varianta 127.0.0.1); listă cu virgulă pentru altele
CORS_ORIGIN=

# Migrările rulează la pornirea API-ului. "false" doar dacă le rulezi separat (npm run migration:run:prod).
DB_MIGRATIONS_RUN=

# Documentația /api/docs: implicit pornită în afara producției. true/false o forțează.
SWAGGER_ENABLED=
# Doar în spatele unui reverse proxy (nginx, Render, Railway...): numărul de proxy-uri, ex. 1.
# Altfel limitarea cererilor ar vedea toți utilizatorii cu IP-ul proxy-ului.
TRUST_PROXY=

# Emailuri (README, „Email”). Fără RESEND_API_KEY, emailurile sunt doar scrise în log.
# onboarding@resend.dev livrează doar către adresa contului tău Resend; pentru alți destinatari verifică un domeniu.
MAIL_FROM=EventHub <onboarding@resend.dev>
# Adresa frontend-ului, pentru linkurile din emailuri.
APP_URL=http://localhost:5100
# Fusul orar al datelor din emailuri.
APP_TIMEZONE=Europe/Bucharest

# Harta: locațiile se caută în fundal pe Nominatim (OpenStreetMap). off = fără cereri, fără hartă.
GEOCODER=nominatim
# Politica Nominatim cere identificarea aplicației; pune un contact, ex. EventHub/1.0 (+https://eventhub.ro; contact@eventhub.ro)
GEOCODER_USER_AGENT=
# Țările în care se caută (coduri ISO separate prin virgulă; gol = oriunde)
GEOCODER_COUNTRY=ro

# Opțional: „Continuă cu Google” (Google Cloud Console → OAuth client „Web application”;
# Authorized redirect URI = PUBLIC_API_URL + /auth/google/callback). Ambele goale = fără Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opțional: Cloudflare Turnstile pe înregistrare, autentificare și „Ai uitat parola?”. Ambele goale = oprit.
# Chei de test Cloudflare: site 1x00000000000000000000AA + secret 1x0000000000000000000000000000000AA (trec mereu).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Opțional: bilete cu plată prin Stripe Checkout. Ambele goale = doar evenimente gratuite.
# Webhook (Stripe Dashboard → Developers → Webhooks): PUBLIC_API_URL + /payments/webhook, evenimentele
# checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired.
# Local: stripe listen --forward-to localhost:5200/api/payments/webhook (afișează secretul whsec_…).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Opțional: erorile neprevăzute (500) trimise la Sentry. Gol = oprit.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Adresa publică a API-ului (cu /api), pentru linkurile „.ics” din emailuri.
PUBLIC_API_URL=http://localhost:5200/api

# Cookie-ul de sesiune (refresh token, httpOnly). Implicit: Secure în producție, SameSite=lax.
# Frontend-ul și API-ul trebuie să fie pe același site (ex. eventhub.ro + api.eventhub.ro). Vezi README, „Sesiuni”.
COOKIE_SECURE=
COOKIE_SAMESITE=
COOKIE_DOMAIN=

# SECRETE: pune aici aceleași valori ca în secrets/*.txt
DB_PASSWORD=
JWT_SECRET=
ORGANIZER_INVITE_CODE=
# Opțional (secrets/resend_api_key.txt). Gol = fără emailuri reale.
RESEND_API_KEY=
# Opțional (secrets/cloudinary_url.txt): cloudinary://<api_key>:<api_secret>@<cloud_name>.
# Gol = imaginile de copertă se salvează local, în UPLOADS_DIR (implicit ./uploads).
CLOUDINARY_URL=
UPLOADS_DIR=
