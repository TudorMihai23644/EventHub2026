# Adresa backend-ului (pentru producție folosește URL-ul public al API-ului)
VITE_API_URL=http://localhost:5200/api

# Opțional: plăcile hărții (implicit OpenStreetMap, potrivit doar pentru trafic mic)
# VITE_MAP_TILES_URL=https://tiles.example.com/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; Furnizor

# Opțional: raportarea erorilor din browser la Sentry (fără DSN, SDK-ul nici nu se încarcă)
# VITE_SENTRY_DSN=https://<cheie>@o0.ingest.sentry.io/0
